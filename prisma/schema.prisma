generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  nickname  String
  email     String    @unique
  istAdmin  Boolean   @default(false)
  link      String?
  createdAt DateTime  @default(now())
  quellen   Quelle[]
  upvotes   Upvote[]
  tagVotes  TagVote[]
}

// Eine Quelle ist nur der Container, aus dem der Crawler Materialien zieht.
model Quelle {
  id            Int        @id @default(autoincrement())
  url           String     @unique // normalisiert
  typ           String // WEBSITE | GIT | CLOUD
  fach          String? // optionaler Hinweis der Melder:in (Fach-Code, z.B. "informatik")
  titel         String?
  beschreibung  String?
  qualityScore  Int? // 0–100 von der AI; <20 = nicht aufgenommen
  todesCounter  Int        @default(0) // fehlgeschlagene Crawl-Nächte in Folge; >=3 = ausgeblendet
  etag          String?
  contentHash   String?
  lastCrawledAt DateTime?
  createdAt     DateTime   @default(now())
  melder        User       @relation(fields: [melderId], references: [id])
  melderId      Int
  materialien   Material[]
}

// Fach (Informatik) ist die Navigations- und Melde-Einheit; ein Fach hat einen oder mehrere
// Lehrpläne (RLP 2024: Grundlagenfach, Ergänzungsfach, Schwerpunktfach). Die Hierarchie
// darunter: Lehrplan → Lerngebiet → Teilgebiet → Kompetenz (feinste Ebene).
// Admins sollen pro Fach Lehrpläne mit diesen Ebenen erfassen können.
model Fach {
  id         Int        @id @default(autoincrement())
  code       String     @unique // z.B. "informatik"
  name       String // z.B. "Informatik"
  lehrplaene Lehrplan[]
}

model Lehrplan {
  id          Int          @id @default(autoincrement())
  code        String       @unique // z.B. "informatik-gf" — steckt in URLs und AI-Zuordnungscodes
  name        String // z.B. "Grundlagenfach"
  url         String? // Link aufs Original (RLP-PDF)
  fach        Fach         @relation(fields: [fachId], references: [id], onDelete: Cascade)
  fachId      Int
  lerngebiete Lerngebiet[]

  @@index([fachId])
}

model Lerngebiet {
  id          Int          @id @default(autoincrement())
  lehrplan    Lehrplan     @relation(fields: [lehrplanId], references: [id], onDelete: Cascade)
  lehrplanId  Int
  nummer      Int // "1"
  name        String // "Algorithmen und Programme"
  teilgebiete Teilgebiet[]

  @@unique([lehrplanId, nummer])
}

model Teilgebiet {
  id           Int                 @id @default(autoincrement())
  lerngebiet   Lerngebiet          @relation(fields: [lerngebietId], references: [id], onDelete: Cascade)
  lerngebietId Int
  code         String // "1.2"
  name         String // "Algorithmische Problemlösung"
  kompetenzen  Kompetenz[]
  zuordnungen  MaterialZuordnung[]

  @@index([lerngebietId])
}

model Kompetenz {
  id           Int                 @id @default(autoincrement())
  teilgebiet   Teilgebiet          @relation(fields: [teilgebietId], references: [id], onDelete: Cascade)
  teilgebietId Int
  code         String // "1.2.1" (RLP nummeriert Kompetenzen nicht — eigene Zählung)
  text         String
  zuordnungen  MaterialZuordnung[]

  @@index([teilgebietId])
}

model Material {
  id             Int                @id @default(autoincrement())
  quelle         Quelle             @relation(fields: [quelleId], references: [id], onDelete: Cascade)
  quelleId       Int
  url            String             @unique
  titel          String
  zusammenfassung String
  qualityScore   Int? // pro Material — eine Quelle kann gute und schwache Seiten enthalten
  format         String? // deterministisch vom Crawler: webseite|markdown|repo|pdf|dokument|präsentation|video
  fehlCounter    Int                @default(0) // Crawls in Folge, in denen die URL fehlte; >=3 = ausgeblendet
  versteckt      Boolean            @default(false) // von Admin ausgeblendet
  contentHash    String?
  // HTTP-Caching fürs nächtliche Re-Crawling: 304 via If-None-Match/If-Modified-Since,
  // bzw. Seite ganz überspringen, wenn die Sitemap dasselbe lastmod meldet wie zuletzt.
  httpEtag       String?
  httpLastMod    String?
  sitemapLastmod String?
  createdAt      DateTime           @default(now())
  zuordnungen    MaterialZuordnung[]
  tags           MaterialTag[]
  upvotes        Upvote[]

  @@index([quelleId])
}

// Material kann einem ganzen Teilgebiet oder einer einzelnen Kompetenz zugeordnet sein.
// teilgebietId ist immer gesetzt (bei Kompetenz-Zuordnung deren Teilgebiet) — vereinfacht Abfragen.
model MaterialZuordnung {
  id           Int         @id @default(autoincrement())
  material     Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId   Int
  teilgebiet   Teilgebiet  @relation(fields: [teilgebietId], references: [id], onDelete: Cascade)
  teilgebietId Int
  kompetenz    Kompetenz?  @relation(fields: [kompetenzId], references: [id], onDelete: Cascade)
  kompetenzId  Int?

  @@index([materialId])
  // zusammengesetzt: die EXISTS-Abfragen «hat Material X eine Zuordnung zu Teilgebiet Y»
  // finden sonst per teilgebietId ~2000 Zeilen und scannen die pro Material (1.6 s)
  @@index([teilgebietId, materialId])
  @@index([kompetenzId, materialId])
}

model Tag {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  status   String        @default("AKTIV") // AKTIV | VORSCHLAG (AI-Vorschlag, wird mit 3 Votes AKTIV)
  material MaterialTag[]
  votes    TagVote[]
}

model MaterialTag {
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId Int
  tag        Tag      @relation(fields: [tagId], references: [id])
  tagId      Int

  @@id([materialId, tagId])
  @@index([tagId])
}

model Upvote {
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId Int
  wert       Int      @default(1) // +1 Upvote, -1 Downvote

  @@id([userId, materialId])
  @@index([materialId])
}

model TagVote {
  user   User @relation(fields: [userId], references: [id])
  userId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@id([userId, tagId])
  @@index([tagId])
}

// Gelöschte Quellen: der Verzeichnis-Sync soll sie nicht wieder anlegen.
// Manuelles Neu-Melden hebt die Sperre auf.
model QuellenSperre {
  url      String   @id
  erstellt DateTime @default(now())
}
